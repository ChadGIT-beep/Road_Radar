modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
# 20s was not enough to install a large new dependency (maplibre-gl) on a cold
# store: the hook timed out mid-install and left node_modules missing it, so the
# dev server failed with "Failed to resolve import".
timeoutMs = 180000
